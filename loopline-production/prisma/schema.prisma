// Loopline — AI Customer Support Chatbot SaaS
// Prisma schema (SQLite for dev; swap datasource to postgres for prod)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth (NextAuth + Prisma adapter)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String? // credentials provider only
  hashedPassword String? // alias kept for clarity in some flows

  // billing
  stripeCustomerId String?

  // active workspace (the one the user is currently working in)
  workspaceId String?
  workspace   Workspace? @relation("UserActiveWorkspace", fields: [workspaceId], references: [id], onDelete: SetNull)

  accounts    Account[]
  sessions    Session[]
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  memberships WorkspaceMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  email      String
  token      String   @unique
  expires    DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Workspace (top-level billing + multi-bot container — supports agencies)
// ─────────────────────────────────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User             @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  activeUsers User[]           @relation("UserActiveWorkspace")
  members     WorkspaceMember[]
  bots        Bot[]
  subscription Subscription?

  @@index([ownerId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole @default(OWNER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Bots + Knowledge Base
// ─────────────────────────────────────────────────────────────────────────────

model Bot {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  avatarUrl      String?
  primaryColor   String   @default("#1a56db")
  welcomeMessage String   @default("Hi! How can I help you today?")
  position       BotPosition @default(BOTTOM_RIGHT)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeChunks  KnowledgeChunk[]
  conversations    Conversation[]

  @@index([workspaceId])
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  botId      String
  content    String
  sourceName String
  createdAt  DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Conversations + Messages
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id         String             @id @default(cuid())
  botId      String
  visitorId  String // browser-local anon id, no PII
  visitorName String?
  status     ConversationStatus @default(AI)
  title      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  bot      Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([botId])
  @@index([status])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing
// ─────────────────────────────────────────────────────────────────────────────

model Subscription {
  id                   String   @id @default(cuid())
  workspaceId          String   @unique
  stripeSubscriptionId String?
  stripePriceId        String?
  status               SubscriptionStatus @default(ACTIVE)
  plan                 Plan     @default(FREE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums (SQLite stores as TEXT — Prisma maps transparently)
// ─────────────────────────────────────────────────────────────────────────────

enum Plan {
  FREE
  PRO
  AGENCY
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum BotPosition {
  BOTTOM_RIGHT
  BOTTOM_LEFT
}

enum ConversationStatus {
  AI
  NEEDS_HUMAN
  RESOLVED
}

enum MessageRole {
  USER
  ASSISTANT
  HUMAN_AGENT
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}
